{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StackAI Claude Code Readiness Assessment",
  "type": "object",
  "required": [
    "assessment_version",
    "scores",
    "total_score",
    "readiness_status",
    "critical_blockers",
    "recommended_pilot",
    "next_actions"
  ],
  "properties": {
    "assessment_version": {
      "type": "string",
      "const": "1.0"
    },
    "company_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "development_model": {
      "type": "string",
      "enum": [
        "internal",
        "freelancer",
        "external_vendor",
        "mixed",
        "none",
        "unknown"
      ]
    },
    "business_goal": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "null",
          "number"
        ]
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "business_objective",
        "system_access",
        "asset_ownership",
        "internal_owner",
        "dev_test_rollback",
        "permissions_governance",
        "security",
        "ongoing_support"
      ],
      "properties": {
        "business_objective": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "system_access": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "asset_ownership": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "internal_owner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "dev_test_rollback": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "permissions_governance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "security": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "ongoing_support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "total_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "readiness_status": {
      "type": "string",
      "enum": [
        "ready_for_pilot",
        "ready_after_limited_preparation",
        "preparation_required",
        "start_with_mapping"
      ]
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_use_case": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_pilot": {
      "type": "string"
    },
    "required_preparation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "string"
      }
    },
    "recommended_stackai_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}